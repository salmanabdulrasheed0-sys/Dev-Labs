    <script>
        /*** 1. GLOBAL SCROLLABLE CANVAS SETUP FOR ALL SECTIONS ***/
        const canvas = document.getElementById('spatial-canvas');
        const ctx = canvas.getContext('2d');
        let balls = [];
        const maxBalls = 250; // Balls quantity increased to span across the total document height flawlessly

        function fitCanvasToDocument() {
            canvas.width = window.innerWidth;
            // Sets canvas height exactly to the total scrollable page height
            canvas.height = document.documentElement.scrollHeight;
        }
        
        // Initial setup and safe re-calculation when dynamic content finishes loading
        window.addEventListener('load', fitCanvasToDocument);
        window.addEventListener('resize', fitCanvasToDocument);
        fitCanvasToDocument();

        class EmotionBall {
            constructor() {
                this.x = Math.random() * canvas.width;
                // Distribute particles across the entire scrollable height from top to bottom
                this.y = Math.random() * canvas.height;
                // Sleek small-medium elegant size configuration
                this.radius = Math.random() * 3 + 3; 
                this.speedX = (Math.random() * 0.4 - 0.2);
                this.speedY = (Math.random() * 0.4 - 0.2);
                this.opacity = Math.random() * 0.35 + 0.15;
            }
            update() {
                this.x += this.speedX;
                this.y += this.speedY;

                // Seamless infinite wrapping across total document space limits
                if (this.x < -this.radius) this.x = canvas.width + this.radius;
                if (this.x > canvas.width + this.radius) this.x = -this.radius;
                if (this.y < -this.radius) this.y = canvas.height + this.radius;
                if (this.y > canvas.height + this.radius) this.y = -this.radius;
            }
            draw() {
                ctx.beginPath();
                let gradient = ctx.createRadialGradient(this.x - this.radius*0.2, this.y - this.radius*0.2, 0.5, this.x, this.y, this.radius);
                gradient.addColorStop(0, `rgba(0, 242, 254, ${this.opacity})`);
                gradient.addColorStop(0.6, `rgba(79, 172, 254, ${this.opacity * 0.5})`);
                gradient.addColorStop(1, 'rgba(0, 242, 254, 0)');
                
                ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
                ctx.fillStyle = gradient;
                ctx.fill();
            }
        }

        // Initialize particles throughout the total expanded body canvas scope
        for (let i = 0; i < maxBalls; i++) {
            balls.push(new EmotionBall());
        }

        function animationLoop() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            balls.forEach(ball => {
                ball.update();
                ball.draw();
            });
            requestAnimationFrame(animationLoop);
        }
        animationLoop();

        /*** 2. HERO INTERACTIVE MOTION EFFECT ***/
        const heroNode = document.getElementById('dynamic-hero');
        window.addEventListener('mousemove', (e) => {
            const centerX = window.innerWidth / 2;
            const centerY = window.innerHeight / 2;
            const rotX = ((centerY - e.clientY) / centerY) * 6; 
            const rotY = ((e.clientX - centerX) / centerX) * 6;
            if(heroNode && window.innerWidth > 768) {
                heroNode.style.transform = `rotateX(${rotX}deg) rotateY(${rotY}deg)`;
            }
        });

        /*** 3. NAVBAR ACTIVE SCROLL LINK DETECTOR ***/
        const sections = document.querySelectorAll('section');
        const navItems = document.querySelectorAll('.nav-links a');

        window.addEventListener('scroll', () => {
            let current = '';
            sections.forEach(sec => {
                const secTop = sec.offsetTop;
                if (window.pageYOffset >= secTop - 160) {
                    current = sec.getAttribute('id');
                }
            });
            navItems.forEach(item => {
                item.classList.remove('active');
                if (item.getAttribute('href') === `#${current}`) {
                    item.classList.add('active');
                }
            });
        });

        /*** 4. INTERSECTION OBSERVER FOR VISUAL STATUS COUNTERS ***/
        const counterNodes = document.querySelectorAll('.stat-count');
        const trackingObserver = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
                if(entry.isIntersecting) {
                    const node = entry.target;
                    const finalTarget = parseInt(node.getAttribute('data-target'), 10);
                    const suffix = node.getAttribute('data-suffix') || '';
                    let startingValue = 0;
                    
                    const totalDuration = 2000; 
                    const refreshRate = 30; 
                    const totalTicks = totalDuration / refreshRate;
                    const incrementVal = finalTarget / totalTicks;
                    
                    const intervalTimer = setInterval(() => {
                        startingValue += incrementVal;
                        if(startingValue >= finalTarget) {
                            node.innerText = finalTarget + suffix;
                            clearInterval(intervalTimer);
                        } else {
                            node.innerText = Math.floor(startingValue) + suffix;
                        }
                    }, refreshRate);
                    
                    observer.unobserve(node);
                }
            });
        }, { threshold: 0.1 });

        counterNodes.forEach(node => trackingObserver.observe(node));
    </script>
